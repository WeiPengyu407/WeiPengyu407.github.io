---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site";

export const getStaticPaths = (async () => {
  const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return articles.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // 每屏一个出口：文章底部只给「下一篇」和「订阅」。
      next: articles[i + 1] ?? articles[0] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={entry.data.title} description={entry.data.saves}>
  <article class="doc">
    <header class="doc__head">
      <p class="doc__meta ui">
        <time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
        {entry.data.tags.length > 0 && <span> · {entry.data.tags.join(" · ")}</span>}
      </p>
      <h1 class="doc__title" transition:name={`t-${entry.id}`}>{entry.data.title}</h1>
      {/* 先给结论。规格和复现步骤在下面。 */}
      <p class="finding doc__saves">
        <strong>结论</strong>　{entry.data.saves}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="doc__foot">
      {
        next && (
          <a class="nextup" href={`/articles/${next.id}/`}>
            <span class="eyebrow">下一篇</span>
            <span class="nextup__title">{next.data.title}</span>
            <span class="nextup__saves ui">{next.data.saves}</span>
          </a>
        )
      }
      <p class="doc__sub ui">
        一周一篇。<a href="/rss.xml">RSS 订阅</a>
        {SITE.email && <> · <a href={`mailto:${SITE.email}`}>写信</a></>}
      </p>
    </footer>
  </article>
</Base>

<style>
  /* 外层比正文列宽：标题和结论可以铺开，正文仍锁在最佳行宽上。
     左边缘对齐，所以看起来是标题探出去，而不是两套栅格。 */
  .doc {
    max-width: 42rem;
    margin: 0 auto;
    padding: 8rem 1.5rem 5rem;
  }

  .doc__head {
    margin-bottom: 3.2rem;
  }

  .doc__meta {
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }

  .doc__title {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    letter-spacing: -0.022em;
    line-height: 1.16;
  }

  /* 整页最重要的一行，别缩成脚注。 */
  .doc__saves {
    margin-top: 1.7rem;
    font-size: 1.05rem;
  }

  .doc__foot {
    margin-top: 5rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--rule);
  }

  .nextup {
    display: block;
    text-decoration: none;
    padding: 1.4rem;
    margin: 0 -1.4rem;
    border-radius: 3px;
    transition: background-color 0.18s var(--ease-out);
  }

  .nextup:hover {
    background: var(--vermilion-wash);
  }

  .nextup .eyebrow {
    margin-bottom: 0.6rem;
  }

  .nextup__title {
    display: block;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .nextup:hover .nextup__title {
    color: var(--vermilion);
  }

  .nextup__saves {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-soft);
  }

  .doc__sub {
    color: var(--ink-faint);
    margin-top: 2.4rem;
  }
</style>
