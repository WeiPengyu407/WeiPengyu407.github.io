---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" });
---

<Base title="文章" description="踩完才写的技术笔记：KDE Plasma、Wayland、AI agent 基建。">
  <div class="wrap">
    {/* 这一页的任务是让人扫，所以不做淡入：动效在这里不携带信息，
        只会让读者对着空白等一拍。淡入留给首页的叙事屏。 */}
    <header class="head">
      <p class="eyebrow">文章</p>
      <h1 class="section-title">全部文章</h1>
      <p class="lede">
        每篇都写清楚了是怎么定位到原因的，不只给结论。日期是发布时间。
      </p>
    </header>

    <ul class="list">
      {
        articles.map((entry) => (
          <li class="list__item">
            <a class="list__link" href={`/articles/${entry.id}/`}>
              <time class="list__date ui" datetime={entry.data.date.toISOString()}>
                {fmt(entry.data.date)}
              </time>
              <span class="list__body">
                <span class="list__title" transition:name={`t-${entry.id}`}>
                  {entry.data.title}
                </span>
                <span class="list__saves">{entry.data.saves}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    {articles.length === 0 && <p class="lede">还没有文章。</p>}
  </div>
</Base>

<style>
  .wrap {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 8rem 1.5rem 6rem;
  }

  .head {
    margin-bottom: 4rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .list__item {
    border-bottom: 1px solid var(--rule);
  }

  .list__link {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1.5rem;
    padding: 1.8rem 0.6rem;
    margin: 0 -0.6rem;
    text-decoration: none;
    transition: background-color 0.18s var(--ease-out);
  }

  .list__link:hover {
    background: var(--vermilion-wash);
  }

  .list__date {
    color: var(--ink-faint);
    padding-top: 0.42rem;
    font-variant-numeric: tabular-nums;
  }

  .list__body {
    display: block;
  }

  .list__title {
    display: block;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .list__link:hover .list__title {
    color: var(--vermilion);
  }

  .list__saves {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 1rem;
    /* ch 是 "0" 的宽度，对汉字来说只有半格，52ch 实际只放得下 26 个字。
       中文行宽用 em 算才准。 */
    max-width: 36em;
  }

  @media (max-width: 34rem) {
    .list__link {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .list__date {
      padding-top: 0;
    }
  }
</style>
